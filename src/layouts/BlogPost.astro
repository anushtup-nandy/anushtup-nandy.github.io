---
import 'katex/dist/katex.min.css';
import BaseLayout from './BaseLayout.astro';
import { formatDate, isoDate, readingTime } from '../utils';
import { site } from '../data/site';
import type { CollectionEntry } from 'astro:content';

interface Props {
  post: CollectionEntry<'blog'>;
  body: string | undefined;
  prev?: { id: string; title: string };
  next?: { id: string; title: string };
}

const { post, body, prev, next } = Astro.props;
const { title, description, pubDate, updatedDate, cover, tags, category } = post.data;

const blogPostingLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description,
  datePublished: isoDate(pubDate),
  dateModified: isoDate(updatedDate ?? pubDate),
  author: { '@type': 'Person', name: site.name, url: Astro.site?.href },
  keywords: tags.join(', '),
  url: new URL(Astro.url.pathname, Astro.site).href,
};
---

<BaseLayout
  title={`${title} | ${site.name}`}
  description={description}
  image={cover ?? '/images/IMG-20241124-WA0042.jpg'}
  article={{ publishedTime: isoDate(pubDate), tags }}
>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(blogPostingLd)} slot="head" />

  <div class="read-progress" aria-hidden="true"></div>

  <article class="shell" style="padding-top: 10rem; padding-bottom: 6rem;">
    <div class="max-w-[68ch] mx-auto mb-10">
      <a href="/blog" class="link-quiet inline-block mb-8">
        <span aria-hidden="true">&#8592;</span> All writing
      </a>
      <div class="metadata mb-4 flex items-center gap-2 flex-wrap">
        <span>{category}</span>
        <span aria-hidden="true">·</span>
        <time datetime={isoDate(pubDate)}>{formatDate(pubDate)}</time>
        <span aria-hidden="true">·</span>
        <span>{readingTime(body)} min read</span>
      </div>
      <h1 class="section-title" style="font-size: clamp(2.25rem, 5vw, 3.4rem);">{title}</h1>
      <p class="mt-6" style="color: var(--text-secondary); font-size: 1.15rem;">{description}</p>
      <div class="flex flex-wrap gap-2 mt-5">
        {tags.map((t) => <span class="tech-tag">{t}</span>)}
      </div>
    </div>

    {cover && (
      <img src={cover} alt="" class="max-w-4xl w-full mx-auto mb-12" style="border: 1px solid var(--border);" />
    )}

    <div class="prose">
      <slot />
    </div>

    <div class="max-w-[68ch] mx-auto">
      {(prev || next) && (
        <nav class="post-nav" aria-label="Post navigation">
          {prev ? (
            <a href={`/blog/${prev.id}/`} class="prev">
              <span class="metadata">← Previous</span>
              <span class="mt-1" style="color: var(--text-primary);">{prev.title}</span>
            </a>
          ) : <span></span>}
          {next ? (
            <a href={`/blog/${next.id}/`} class="next">
              <span class="metadata">Next →</span>
              <span class="mt-1" style="color: var(--text-primary);">{next.title}</span>
            </a>
          ) : <span></span>}
        </nav>
      )}
    </div>
  </article>

  <script>
    // Inject copy-to-clipboard buttons into code blocks.
    document.querySelectorAll<HTMLPreElement>('.prose pre').forEach((pre) => {
      const btn = document.createElement('button');
      btn.className = 'copy-btn';
      btn.type = 'button';
      btn.textContent = 'Copy';
      btn.addEventListener('click', async () => {
        const code = pre.querySelector('code')?.innerText ?? pre.innerText;
        try {
          await navigator.clipboard.writeText(code);
          btn.textContent = 'Copied';
          setTimeout(() => (btn.textContent = 'Copy'), 1500);
        } catch {
          btn.textContent = 'Failed';
        }
      });
      pre.appendChild(btn);
    });
  </script>
</BaseLayout>
