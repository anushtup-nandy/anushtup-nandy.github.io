---
import { publications } from '../data/publications';
---

<section id="publications" class="py-24">
  <h2 class="section-title text-center mb-12 reveal">Publications.</h2>
  <div class="max-w-4xl mx-auto p-8 rounded-2xl border" style="background: var(--bg-secondary); border-color: var(--border);">
    <div class="divide-y" style="border-color: var(--border);">
      {publications.map((pub) => (
        <div class="publication-item reveal">
          <div>
            <h3>{pub.title}</h3>
            <p><span set:html={pub.authors} /><br /><em>{pub.venue}</em></p>
          </div>
          <a href={pub.pdf} target="_blank" rel="noopener noreferrer" class="btn btn-secondary">
            PDF <i class="fas fa-file-pdf ml-2"></i>
          </a>
        </div>
      ))}
    </div>
  </div>
</section>
