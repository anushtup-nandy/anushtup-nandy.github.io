---
import { publications } from '../data/publications';
---

<section id="publications" class="plate">
  <div class="shell">
    <header class="sheet-head reveal">
      <p class="sheet-index">05 / Papers</p>
      <div>
        <h2 class="section-title">Publications</h2>
      </div>
    </header>

    <div class="pub-list">
      {publications.map((pub, i) => (
        <article class="publication-item reveal">
          <span class="pub-n">{String(i + 1).padStart(2, '0')}</span>
          <div>
            <h3>{pub.title}</h3>
            <p class="pub-authors">
              <span set:html={pub.authors} />
              <span class="pub-venue">{pub.venue}</span>
            </p>
          </div>
          <div class="pub-pdf">
            <a href={pub.pdf} target="_blank" rel="noopener noreferrer" class="link-quiet">
              PDF <span aria-hidden="true">&#8599;</span>
            </a>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
