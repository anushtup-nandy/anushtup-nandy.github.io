---
import { site, nav } from '../data/site';
---

<header class="fixed top-0 left-0 w-full z-50">
  <div class="shell">
    <nav class="nav-bar" aria-label="Primary">
      <a href="/" class="brand-mark" aria-label={`${site.name} — home`}>
        {site.initials}<span class="brand-sub" aria-hidden="true">Robotics &amp; Control</span>
      </a>

      <div class="hidden md:flex items-center">
        {nav.map((item) => <a href={item.href} class="nav-link">{item.label}</a>)}
        <button id="theme-toggle" type="button" aria-label="Toggle colour theme">
          <svg viewBox="0 0 20 20" width="13" height="13" aria-hidden="true">
            <circle cx="10" cy="10" r="7.25" fill="none" stroke="currentColor" stroke-width="1.2" />
            <path d="M10 2.75a7.25 7.25 0 0 0 0 14.5z" fill="currentColor" />
          </svg>
        </button>
      </div>

      <button class="md:hidden menu-btn" type="button" aria-label="Open menu">
        <span></span><span></span>
      </button>
    </nav>
  </div>
</header>

<div class="mobile-menu">
  {nav.map((item) => <a href={item.href} class="nav-link">{item.label}</a>)}
</div>
