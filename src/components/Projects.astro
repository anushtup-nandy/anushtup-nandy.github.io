---
import { projects } from '../data/projects';

const filters = [
  { key: 'all', label: 'All' },
  { key: 'robotics', label: 'Robotics' },
  { key: 'ai-ml', label: 'AI/ML' },
  { key: 'web', label: 'Web Apps' },
  { key: 'research', label: 'Research' },
];

// Publication-backed work has no repo: point it at the papers section rather
// than shipping a dead `#` link. Pending work stays inert, styled as inert.
const destination = (p: (typeof projects)[number]) =>
  p.github ?? (p.publication === 'See Publication' ? '/#publications' : null);
---

<section id="projects" class="plate">
  <div class="shell">
    <header class="sheet-head reveal">
      <p class="sheet-index">04 / Index</p>
      <div>
        <h2 class="section-title">Selected <em>projects</em></h2>
        <p class="sheet-lede">Control stacks, learned policies, multi-agent systems, and a few weekends that got out of hand.</p>
        <div class="category-filter mt-8">
          <span class="filter-indicator" aria-hidden="true"></span>
          {filters.map((f, i) => (
            <button class:list={['filter-btn', i === 0 && 'active']} data-category={f.key} aria-pressed={i === 0}>
              {f.label}
            </button>
          ))}
        </div>
      </div>
    </header>

    <ul class="work-index">
      {projects.map((p, i) => {
        const href = destination(p);
        const external = Boolean(p.github);
        const Row = href ? 'a' : 'div';
        return (
          <li class:list={['project-card', 'reveal', p.featured && 'featured']} data-category={p.categories.join(' ')}>
            <Row
              class="work-link"
              data-image={p.image}
              {...(href ? { href } : {})}
              {...(external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
              {...(href ? {} : { 'data-pending': 'true' })}
            >
              <span class="work-num">{String(i + 1).padStart(2, '0')}</span>
              <span class="work-head">
                <span class="work-title">{p.title}</span>
                {href && <span class="work-go" aria-hidden="true">{external ? '↗' : '→'}</span>}
              </span>
              <span class="work-desc">{p.description}</span>
              <span class="work-meta">
                {p.tags.map((t) => <span class="tech-tag">{t}</span>)}
              </span>
              <span class="work-kind">{href ? p.badge : p.publication}</span>
            </Row>
          </li>
        );
      })}
    </ul>
  </div>
</section>

<script>
  const buttons = [...document.querySelectorAll<HTMLButtonElement>('.filter-btn')];
  const cards = [...document.querySelectorAll<HTMLElement>('.project-card')];
  const thumb = document.querySelector<HTMLElement>('.filter-indicator');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // Typed locally: startViewTransition isn't in every lib.dom we might build against.
  const startViewTransition = (
    document as Document & {
      startViewTransition?: (cb: () => void) => { finished: Promise<void> };
    }
  ).startViewTransition?.bind(document);

  // offsetLeft/Top are relative to .category-filter (position: relative), so this
  // tracks a wrapped second row on narrow screens too.
  const moveThumb = (btn: HTMLElement) => {
    if (!thumb) return;
    thumb.style.width = `${btn.offsetWidth}px`;
    thumb.style.height = `${btn.offsetHeight}px`;
    thumb.style.setProperty('--fx', `${btn.offsetLeft}px`);
    thumb.style.setProperty('--fy', `${btn.offsetTop}px`);
  };

  const applyFilter = (category: string) => {
    for (const card of cards) {
      const cats = card.dataset.category || '';
      card.classList.toggle('hidden', !(category === 'all' || cats.includes(category)));
    }
  };

  for (const button of buttons) {
    button.addEventListener('click', () => {
      const category = button.dataset.category || 'all';
      for (const b of buttons) {
        const on = b === button;
        b.classList.toggle('active', on);
        b.setAttribute('aria-pressed', String(on));
      }
      moveThumb(button);

      // Naming each row hands the reflow to the browser: survivors are FLIPped
      // into their new slots, dropped ones fade out. Names are cleared afterwards
      // so they never affect ordinary hover/paint.
      if (reduce || !startViewTransition) return applyFilter(category);
      cards.forEach((c, i) => c.style.setProperty('view-transition-name', `pcard-${i}`));
      startViewTransition(() => applyFilter(category)).finished.finally(() => {
        for (const c of cards) c.style.removeProperty('view-transition-name');
      });
    });
  }

  const activeBtn = () => buttons.find((b) => b.classList.contains('active'));
  // Measure once layout/fonts settle, then arm the thumb's transitions so it
  // never animates in from the container origin.
  requestAnimationFrame(() => {
    const b = activeBtn();
    if (b) moveThumb(b);
    requestAnimationFrame(() => thumb?.classList.add('ready'));
  });

  let resizeTimer: number;
  window.addEventListener('resize', () => {
    clearTimeout(resizeTimer);
    resizeTimer = window.setTimeout(() => {
      const b = activeBtn();
      if (b) moveThumb(b);
    }, 150);
  });

  // ---- Hover preview plate. One reused element, pointer-driven, desktop only.
  // An index row can't show its image inline without becoming a card again, so
  // the image comes to the cursor instead.
  const rows = [...document.querySelectorAll<HTMLElement>('.work-link[data-image]')];
  const fine = window.matchMedia('(hover: hover) and (min-width: 1024px)').matches;
  if (rows.length && fine && !reduce) {
    const peek = document.createElement('div');
    peek.className = 'work-peek';
    peek.setAttribute('aria-hidden', 'true');
    const img = document.createElement('img');
    img.alt = '';
    peek.appendChild(img);
    document.body.appendChild(peek);

    let raf = 0;
    let px = 0;
    let py = 0;
    const place = () => {
      raf = 0;
      peek.style.setProperty('--px', `${px}px`);
      peek.style.setProperty('--py', `${py}px`);
    };

    for (const row of rows) {
      row.addEventListener('pointerenter', () => {
        const src = row.dataset.image;
        if (!src) return;
        if (img.getAttribute('src') !== src) img.src = src;
        peek.classList.add('on');
      });
      row.addEventListener('pointerleave', () => peek.classList.remove('on'));
      row.addEventListener('pointermove', (e) => {
        // Keep the plate on screen: flip left of the cursor near the right edge.
        const w = peek.offsetWidth || 320;
        const h = peek.offsetHeight || 240;
        px = Math.min(e.clientX + 28, window.innerWidth - w - 16);
        py = Math.min(Math.max(e.clientY - h / 2, 16), window.innerHeight - h - 16);
        if (!raf) raf = requestAnimationFrame(place);
      });
    }
  }
</script>
