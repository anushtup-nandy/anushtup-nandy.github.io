---
import { site } from '../data/site';
import { experience } from '../data/experience';
import { publications } from '../data/publications';

// Split for the per-word mask reveal (see .reveal-words in global.css).
// The closing clause takes the italic display treatment.
const taglineWords = site.tagline.split(' ');
const emFrom = taglineWords.length - 2;

const current = experience[0];
const readout = [
  { k: 'Current', v: `${current.title}, ${current.org.split('·')[0].trim()}` },
  { k: 'Focus', v: 'Motion planning · MPC · Sim-to-real' },
  { k: 'Published', v: `${publications.length} peer-reviewed papers` },
  { k: 'Based', v: site.location },
];
---

<section id="home">
  <div class="shell hero-body">
    <div class="hero-inner">
      <p class="hero-eyebrow reveal">
        <span class="status-dot" aria-hidden="true"></span>{site.role}
      </p>
      <h1 class="reveal reveal-words" style="--delay: 0.06s;">
        {taglineWords.map((w, i) => (
          <><span class:list={['word', i >= emFrom && 'word-em']} style={`--wi: ${i};`}><span>{w}</span></span>{i === 1 && <br class="hidden md:inline" />}</>
        ))}
      </h1>
      <p class="hero-sub reveal" style="--delay: 0.3s;">
        I'm a Robotics Engineer and Researcher at the intersection of motion planning, deep learning and control theory.
      </p>
      <div class="hero-cta reveal" style="--delay: 0.42s;">
        <a href="/#projects" class="btn btn-primary">View my work <span class="arrow" aria-hidden="true">&#8594;</span></a>
        <a href="/pdfs/AnushtupNandyCV.pdf" target="_blank" rel="noopener" class="btn btn-secondary">
          Resume <span class="arrow" aria-hidden="true">&#8599;</span>
        </a>
        <a href="/#contact" class="link-quiet">Get in touch</a>
      </div>
    </div>

    <canvas id="hero-canvas" aria-hidden="true"></canvas>

    <dl class="hero-readout reveal" style="--delay: 0.58s;">
      {readout.map((r) => (
        <div class="readout-cell">
          <dt>{r.k}</dt>
          <dd>{r.v}</dd>
        </div>
      ))}
    </dl>
  </div>
</section>

<script>
  // Signature: a 2-link planar manipulator under closed-form IK. The cursor is
  // the reference input; the joints track it through a first-order lag — a
  // control loop you can feel. Idle → the reference rides a figure-eight orbit.
  // Reduced motion → a single static frame of the same scene.
  const canvas = document.getElementById('hero-canvas') as HTMLCanvasElement | null;
  if (canvas) {
    const ctx = canvas.getContext('2d')!;
    const section = document.getElementById('home') as HTMLElement;
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const cssVar = (n: string, f: string) =>
      getComputedStyle(document.documentElement).getPropertyValue(n).trim() || f;

    let W = 0, H = 0, tick = 0, hud = true;
    // Geometry: base (bx,by), link lengths L1/L2, reach annulus [rMin, rMax].
    let bx = 0, by = 0, L1 = 0, L2 = 0, rMax = 0, rMin = 0;
    // Idle reference orbit (figure-eight) parameters.
    let ox = 0, oy = 0, oa = 0, ob = 0;
    // Joint state boots folded at the base; the tracking lag unfolds it on load.
    let a1 = Math.PI * 0.75, a2 = -2.9;
    // tx/ty = raw reference; mx/my = smoothed reference fed to the controller.
    let tx = 0, ty = 0, mx = 0, my = 0, hasPointer = false, idleAt = 0;
    const trace: [number, number][] = [];

    const wrap = (a: number) => Math.atan2(Math.sin(a), Math.cos(a));
    const orbitAt = (s: number): [number, number] =>
      [ox + oa * Math.cos(s), oy + ob * Math.sin(2 * s)];

    // Closed-form 2-link IK, elbow-up, target clamped into the reach annulus.
    const solveIK = (x: number, y: number): [number, number] => {
      const ang = Math.atan2(y - by, x - bx);
      const d = Math.min(rMax * 0.99, Math.max(rMin * 1.05, Math.hypot(x - bx, y - by)));
      const c2 = Math.max(-1, Math.min(1, (d * d - L1 * L1 - L2 * L2) / (2 * L1 * L2)));
      const q2 = -Math.acos(c2);
      return [ang - Math.atan2(L2 * Math.sin(q2), L1 + L2 * Math.cos(q2)), q2];
    };

    const resize = () => {
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      // Canvas is full-bleed (100vw), wider than its section — size from itself.
      W = canvas.clientWidth;
      H = canvas.clientHeight;
      canvas.width = W * dpr;
      canvas.height = H * dpr;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      const mobile = W < 768;
      const narrow = !mobile && W < 1100;
      // Telemetry only where there is room for it below the arm.
      hud = !mobile && !narrow;
      bx = W * (mobile ? 0.52 : narrow ? 0.85 : 0.82);
      by = H * (mobile ? 0.93 : narrow ? 0.7 : 0.78);
      // Mobile gets a short, wide band — clamp against a scaled height so the
      // arm still fills it instead of collapsing to the band's thickness.
      rMax = mobile
        ? Math.min(W, H * 1.6) * 0.44
        : Math.min(W, H) * (narrow ? 0.36 : 0.46);
      L1 = rMax * 0.56;
      L2 = rMax * 0.44;
      rMin = L1 - L2;
      ox = bx - rMax * (mobile ? 0.34 : 0.45);
      oy = by - rMax * (mobile ? 0.6 : 0.55);
      oa = rMax * (mobile ? 0.4 : 0.3);
      ob = rMax * (mobile ? 0.22 : 0.19);
      [tx, ty] = orbitAt(0);
      [mx, my] = [tx, ty];
      trace.length = 0;
    };

    const deg = (a: number) => `${((wrap(a) * 180) / Math.PI).toFixed(1).padStart(6, ' ')}\u00b0`;

    const draw = (tracking: boolean) => {
      const accent = cssVar('--accent', '#e85d2f');
      const trc = cssVar('--trace', '#7ba3b5');
      const steel = cssVar('--text-secondary', '#9b9b99');
      const faint = cssVar('--text-faint', '#5e5e5d');
      const bg = cssVar('--bg-primary', '#0b0b0c');

      ctx.clearRect(0, 0, W, H);

      // Reach envelope — the workspace boundary, faint and dashed.
      ctx.setLineDash([2, 10]);
      ctx.strokeStyle = faint;
      ctx.globalAlpha = 0.5;
      ctx.lineWidth = 1;
      ctx.beginPath();
      ctx.arc(bx, by, rMax, Math.PI, Math.PI * 2);
      ctx.stroke();

      // Idle: show the reference orbit the controller is following.
      if (!tracking) {
        ctx.globalAlpha = 0.32;
        ctx.beginPath();
        for (let i = 0; i <= 160; i++) {
          const [x, y] = orbitAt((i / 160) * Math.PI * 2);
          i ? ctx.lineTo(x, y) : ctx.moveTo(x, y);
        }
        ctx.stroke();
      }
      ctx.setLineDash([]);
      ctx.globalAlpha = 1;

      // Fixed support: pedestal + ground hatching, straight off the drawing sheet.
      ctx.strokeStyle = steel;
      ctx.globalAlpha = 0.75;
      ctx.lineWidth = 1.25;
      ctx.beginPath();
      ctx.moveTo(bx - 7, by + 3);
      ctx.lineTo(bx - 13, by + 15);
      ctx.lineTo(bx + 13, by + 15);
      ctx.lineTo(bx + 7, by + 3);
      ctx.moveTo(bx - 42, by + 15);
      ctx.lineTo(bx + 42, by + 15);
      for (let i = 0; i < 6; i++) {
        const x = bx - 33 + i * 13;
        ctx.moveTo(x + 7, by + 15);
        ctx.lineTo(x, by + 24);
      }
      ctx.stroke();
      ctx.globalAlpha = 1;

      // Forward kinematics.
      const ex = bx + L1 * Math.cos(a1), ey = by + L1 * Math.sin(a1);
      const hx = ex + L2 * Math.cos(a1 + a2), hy = ey + L2 * Math.sin(a1 + a2);

      // End-effector trace: alpha ramps toward the tip, so holding still clears it.
      trace.push([hx, hy]);
      if (trace.length > 140) trace.shift();
      ctx.strokeStyle = trc;
      ctx.lineWidth = 1.2;
      for (let i = 1; i < trace.length; i++) {
        ctx.globalAlpha = (i / trace.length) * 0.55;
        ctx.beginPath();
        ctx.moveTo(trace[i - 1][0], trace[i - 1][1]);
        ctx.lineTo(trace[i][0], trace[i][1]);
        ctx.stroke();
      }
      ctx.globalAlpha = 1;

      // Links.
      ctx.strokeStyle = steel;
      ctx.lineCap = 'round';
      ctx.lineWidth = 2.5;
      ctx.beginPath();
      ctx.moveTo(bx, by);
      ctx.lineTo(ex, ey);
      ctx.lineTo(hx, hy);
      ctx.stroke();

      // Gripper prongs along the wrist direction.
      const dir = a1 + a2;
      ctx.strokeStyle = accent;
      ctx.lineWidth = 1.8;
      ctx.beginPath();
      for (const off of [-0.5, 0.5]) {
        ctx.moveTo(hx, hy);
        ctx.lineTo(hx + 12 * Math.cos(dir + off), hy + 12 * Math.sin(dir + off));
      }
      ctx.stroke();

      // Joints: instrument circles over the linework.
      const joints: [number, number, number][] = [[bx, by, 5.5], [ex, ey, 4], [hx, hy, 2.5]];
      for (const [jx, jy, r] of joints) {
        ctx.beginPath();
        ctx.arc(jx, jy, r, 0, Math.PI * 2);
        ctx.fillStyle = bg;
        ctx.fill();
        ctx.strokeStyle = accent;
        ctx.lineWidth = 1.4;
        ctx.stroke();
      }

      // Reference marker at the (smoothed) target.
      const dirs: [number, number][] = [[1, 0], [-1, 0], [0, 1], [0, -1]];
      ctx.strokeStyle = accent;
      ctx.fillStyle = accent;
      ctx.globalAlpha = tracking ? 0.9 : 0.45;
      ctx.lineWidth = 1.2;
      ctx.beginPath();
      for (const [ux, uy] of dirs) {
        ctx.moveTo(mx + ux * 5, my + uy * 5);
        ctx.lineTo(mx + ux * 14, my + uy * 14);
      }
      ctx.stroke();
      ctx.globalAlpha = 1;

      // Telemetry readout — live joint state, not decoration.
      if (hud) {
        ctx.font = '9.5px "IBM Plex Mono", monospace';
        ctx.textAlign = 'right';
        ctx.fillStyle = accent;
        ctx.fillText(tracking ? 'TRACKING' : 'IDLE', W - 32, H - 156);
        ctx.fillStyle = faint;
        ctx.fillText(`\u03b81 ${deg(a1)}   \u03b82 ${deg(a2)}`, W - 32, H - 140);
        ctx.fillText(`ee ${Math.round(hx)}, ${Math.round(hy)}`, W - 32, H - 124);
        ctx.textAlign = 'left';
      }
    };

    let raf = 0;
    const loop = () => {
      tick++;
      const tracking = hasPointer && tick < idleAt;
      if (!tracking) [tx, ty] = orbitAt(tick * 0.008);
      // Reference shaping + first-order joint tracking.
      mx += (tx - mx) * 0.12;
      my += (ty - my) * 0.12;
      const [q1, q2] = solveIK(mx, my);
      a1 += wrap(q1 - a1) * 0.085;
      a2 += wrap(q2 - a2) * 0.085;
      draw(tracking);
      raf = requestAnimationFrame(loop);
    };

    const staticFrame = () => {
      [tx, ty] = orbitAt(Math.PI);
      [mx, my] = [tx, ty];
      [a1, a2] = solveIK(tx, ty);
      draw(false);
    };

    // Listen on the section so events over the hero text still register
    // (the canvas itself is pointer-events: none).
    section.addEventListener('pointermove', (e) => {
      const r = canvas.getBoundingClientRect();
      tx = e.clientX - r.left;
      ty = e.clientY - r.top;
      hasPointer = true;
      idleAt = tick + 150; // hold ~2.5 s after the cursor stops
    });
    section.addEventListener('pointerleave', () => { hasPointer = false; });

    resize();
    if (reduce) staticFrame();
    else loop();

    // Re-measure whenever the element's box changes — window resize alone
    // misses the reflow that lands when the display webfont finishes loading.
    let rt: number;
    const relayout = () => {
      clearTimeout(rt);
      rt = window.setTimeout(() => {
        if (canvas.clientWidth === W && canvas.clientHeight === H) return;
        cancelAnimationFrame(raf);
        resize();
        if (reduce) staticFrame();
        else loop();
      }, 150);
    };
    if ('ResizeObserver' in window) new ResizeObserver(relayout).observe(canvas);
    else window.addEventListener('resize', relayout);
  }
</script>
