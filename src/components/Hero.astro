---
import { site } from '../data/site';

// Split for the per-word mask reveal (see .reveal-words in global.css).
// The closing two words take the technical-outline treatment.
const taglineWords = site.tagline.split(' ');
const outlineFrom = taglineWords.length - 2;
---

<section id="home">
  <canvas id="hero-canvas" aria-hidden="true"></canvas>
  <div class="hero-inner">
    <p class="hero-eyebrow mb-5 reveal">
      <span class="status-dot" aria-hidden="true"></span>{site.role}
    </p>
    <h1 class="reveal reveal-words" style="--delay: 0.06s;">
      {taglineWords.map((w, i) => (
        <><span class:list={['word', i >= outlineFrom && 'word-outline']} style={`--wi: ${i};`}><span>{w}</span></span>{i === 1 && <br class="hidden md:inline" />}</>
      ))}
    </h1>
    <p class="hero-sub text-lg reveal" style="--delay: 0.26s;">
      I'm a Robotics Engineer and Researcher at the intersection of motion planning, deep learning and control theory.
    </p>
    <div class="flex flex-col sm:flex-row gap-4 reveal" style="--delay: 0.38s;">
      <a href="/#projects" class="btn btn-primary">View My Work <i class="fas fa-arrow-right" aria-hidden="true"></i></a>
      <a href="/#contact" class="btn btn-secondary">Get In Touch</a>
      <a href="/pdfs/AnushtupNandyCV.pdf" target="_blank" rel="noopener" class="btn btn-secondary">Resume <i class="fas fa-file-pdf" aria-hidden="true"></i></a>
    </div>
  </div>
  <div class="hero-foot reveal" style="--delay: 0.55s;" aria-hidden="true">
    <span class="scroll-cue"><span class="scroll-line"></span>Scroll</span>
  </div>
</section>

<script>
  // Signature: a 2-link planar manipulator under closed-form IK. The cursor is
  // the reference input; the joints track it through a first-order lag — a
  // control loop you can feel. Idle → the reference rides a figure-eight orbit.
  // Reduced motion → a single static frame of the same scene.
  const canvas = document.getElementById('hero-canvas') as HTMLCanvasElement | null;
  if (canvas) {
    const ctx = canvas.getContext('2d')!;
    const section = canvas.parentElement as HTMLElement;
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const cssVar = (n: string, f: string) =>
      getComputedStyle(document.documentElement).getPropertyValue(n).trim() || f;

    let W = 0, H = 0, tick = 0, hud = true;
    // Geometry: base (bx,by), link lengths L1/L2, reach annulus [rMin, rMax].
    let bx = 0, by = 0, L1 = 0, L2 = 0, rMax = 0, rMin = 0;
    // Idle reference orbit (figure-eight) parameters.
    let ox = 0, oy = 0, oa = 0, ob = 0;
    // Joint state boots folded at the base; the tracking lag unfolds it on load.
    let a1 = Math.PI * 0.75, a2 = -2.9;
    // tx/ty = raw reference; mx/my = smoothed reference fed to the controller.
    let tx = 0, ty = 0, mx = 0, my = 0, hasPointer = false, idleAt = 0;
    const trace: [number, number][] = [];

    const wrap = (a: number) => Math.atan2(Math.sin(a), Math.cos(a));
    const orbitAt = (s: number): [number, number] =>
      [ox + oa * Math.cos(s), oy + ob * Math.sin(2 * s)];

    // Closed-form 2-link IK, elbow-up, target clamped into the reach annulus.
    const solveIK = (x: number, y: number): [number, number] => {
      const ang = Math.atan2(y - by, x - bx);
      const d = Math.min(rMax * 0.99, Math.max(rMin * 1.05, Math.hypot(x - bx, y - by)));
      const c2 = Math.max(-1, Math.min(1, (d * d - L1 * L1 - L2 * L2) / (2 * L1 * L2)));
      const q2 = -Math.acos(c2);
      return [ang - Math.atan2(L2 * Math.sin(q2), L1 + L2 * Math.cos(q2)), q2];
    };

    const resize = () => {
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      // Canvas is full-bleed (100vw), wider than its section — size from itself.
      W = canvas.clientWidth;
      H = canvas.clientHeight;
      canvas.width = W * dpr;
      canvas.height = H * dpr;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      const mobile = W < 768;
      hud = !mobile;
      bx = W * (mobile ? 0.72 : 0.7);
      by = H * (mobile ? 0.86 : 0.8);
      rMax = Math.min(W, H) * (mobile ? 0.42 : 0.55);
      L1 = rMax * 0.56;
      L2 = rMax * 0.44;
      rMin = L1 - L2;
      ox = bx - rMax * (mobile ? 0.2 : 0.5);
      oy = by - rMax * 0.52;
      oa = rMax * 0.32;
      ob = rMax * 0.2;
      [tx, ty] = orbitAt(0);
      [mx, my] = [tx, ty];
      trace.length = 0;
    };

    const deg = (a: number) => `${((wrap(a) * 180) / Math.PI).toFixed(1).padStart(6, ' ')}°`;

    const draw = (tracking: boolean) => {
      const accent = cssVar('--accent', '#ff6a3d');
      const cyan = cssVar('--blueprint', '#5cc8e0');
      const steel = cssVar('--text-secondary', '#8a94a3');
      const bg = cssVar('--bg-primary', '#0d1014');

      ctx.clearRect(0, 0, W, H);

      // Reach envelope — the workspace boundary, faint and dashed.
      ctx.setLineDash([3, 9]);
      ctx.strokeStyle = steel;
      ctx.globalAlpha = 0.28;
      ctx.lineWidth = 1;
      ctx.beginPath();
      ctx.arc(bx, by, rMax, Math.PI, Math.PI * 2);
      ctx.stroke();

      // Idle: show the reference orbit the controller is following.
      if (!tracking) {
        ctx.globalAlpha = 0.22;
        ctx.beginPath();
        for (let i = 0; i <= 160; i++) {
          const [x, y] = orbitAt((i / 160) * Math.PI * 2);
          i ? ctx.lineTo(x, y) : ctx.moveTo(x, y);
        }
        ctx.stroke();
      }
      ctx.setLineDash([]);
      ctx.globalAlpha = 1;

      // Fixed support: pedestal + ground hatching, straight off the drawing sheet.
      ctx.strokeStyle = steel;
      ctx.lineWidth = 1.5;
      ctx.beginPath();
      ctx.moveTo(bx - 7, by + 3);
      ctx.lineTo(bx - 13, by + 15);
      ctx.lineTo(bx + 13, by + 15);
      ctx.lineTo(bx + 7, by + 3);
      ctx.moveTo(bx - 42, by + 15);
      ctx.lineTo(bx + 42, by + 15);
      for (let i = 0; i < 6; i++) {
        const x = bx - 33 + i * 13;
        ctx.moveTo(x + 7, by + 15);
        ctx.lineTo(x, by + 24);
      }
      ctx.stroke();

      // Forward kinematics.
      const ex = bx + L1 * Math.cos(a1), ey = by + L1 * Math.sin(a1);
      const hx = ex + L2 * Math.cos(a1 + a2), hy = ey + L2 * Math.sin(a1 + a2);

      // End-effector trace: alpha ramps toward the tip, so holding still clears it.
      trace.push([hx, hy]);
      if (trace.length > 130) trace.shift();
      ctx.strokeStyle = cyan;
      ctx.lineWidth = 1.4;
      for (let i = 1; i < trace.length; i++) {
        ctx.globalAlpha = (i / trace.length) * 0.5;
        ctx.beginPath();
        ctx.moveTo(trace[i - 1][0], trace[i - 1][1]);
        ctx.lineTo(trace[i][0], trace[i][1]);
        ctx.stroke();
      }
      ctx.globalAlpha = 1;

      // Links.
      ctx.strokeStyle = steel;
      ctx.lineCap = 'round';
      ctx.lineWidth = 3;
      ctx.beginPath();
      ctx.moveTo(bx, by);
      ctx.lineTo(ex, ey);
      ctx.lineTo(hx, hy);
      ctx.stroke();

      // Gripper prongs along the wrist direction.
      const dir = a1 + a2;
      ctx.strokeStyle = accent;
      ctx.lineWidth = 2;
      ctx.beginPath();
      for (const off of [-0.5, 0.5]) {
        ctx.moveTo(hx, hy);
        ctx.lineTo(hx + 12 * Math.cos(dir + off), hy + 12 * Math.sin(dir + off));
      }
      ctx.stroke();

      // Joints: instrument circles over the linework.
      const joints: [number, number, number][] = [[bx, by, 6], [ex, ey, 4.5]];
      for (const [jx, jy, r] of joints) {
        ctx.beginPath();
        ctx.arc(jx, jy, r, 0, Math.PI * 2);
        ctx.fillStyle = bg;
        ctx.fill();
        ctx.strokeStyle = accent;
        ctx.lineWidth = 1.6;
        ctx.stroke();
      }

      // Reference marker at the (smoothed) target.
      const dirs: [number, number][] = [[1, 0], [-1, 0], [0, 1], [0, -1]];
      ctx.strokeStyle = accent;
      ctx.fillStyle = accent;
      ctx.globalAlpha = tracking ? 0.95 : 0.55;
      ctx.lineWidth = 1.4;
      ctx.beginPath();
      for (const [ux, uy] of dirs) {
        ctx.moveTo(mx + ux * 4, my + uy * 4);
        ctx.lineTo(mx + ux * 13, my + uy * 13);
      }
      ctx.stroke();
      ctx.beginPath();
      ctx.arc(mx, my, 1.8, 0, Math.PI * 2);
      ctx.fill();
      ctx.globalAlpha = 1;

      // Telemetry readout — live joint state, not decoration.
      if (hud) {
        ctx.font = '10px "IBM Plex Mono", monospace';
        ctx.textAlign = 'right';
        ctx.fillStyle = accent;
        ctx.fillText(tracking ? '● TRACKING' : '○ IDLE', W - 28, H - 46);
        ctx.fillStyle = steel;
        ctx.globalAlpha = 0.9;
        ctx.fillText(`θ1 ${deg(a1)}  θ2 ${deg(a2)}  EE ${Math.round(hx)},${Math.round(hy)}`, W - 28, H - 28);
        ctx.globalAlpha = 1;
        ctx.textAlign = 'left';
      }
    };

    let raf = 0;
    const loop = () => {
      tick++;
      const tracking = hasPointer && tick < idleAt;
      if (!tracking) [tx, ty] = orbitAt(tick * 0.008);
      // Reference shaping + first-order joint tracking.
      mx += (tx - mx) * 0.12;
      my += (ty - my) * 0.12;
      const [q1, q2] = solveIK(mx, my);
      a1 += wrap(q1 - a1) * 0.085;
      a2 += wrap(q2 - a2) * 0.085;
      draw(tracking);
      raf = requestAnimationFrame(loop);
    };

    const staticFrame = () => {
      [tx, ty] = orbitAt(Math.PI);
      [mx, my] = [tx, ty];
      [a1, a2] = solveIK(tx, ty);
      draw(false);
    };

    // Listen on the section so events over the hero text still register
    // (the canvas itself is pointer-events: none).
    section.addEventListener('pointermove', (e) => {
      const r = canvas.getBoundingClientRect();
      tx = e.clientX - r.left;
      ty = e.clientY - r.top;
      hasPointer = true;
      idleAt = tick + 150; // hold ~2.5 s after the cursor stops
    });
    section.addEventListener('pointerleave', () => { hasPointer = false; });

    resize();
    if (reduce) staticFrame();
    else loop();

    let rt: number;
    window.addEventListener('resize', () => {
      clearTimeout(rt);
      rt = window.setTimeout(() => {
        cancelAnimationFrame(raf);
        resize();
        if (reduce) staticFrame();
        else loop();
      }, 200);
    });
  }
</script>
