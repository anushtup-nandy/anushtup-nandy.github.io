---
import { featuredProjects } from '../data/projects';
---

<section id="featured-projects" class="py-24">
  <h2 class="section-title text-center mb-20 reveal">Featured Projects.</h2>
  <div class="grid md:grid-cols-2 gap-8 lg:gap-12 max-w-5xl mx-auto">
    {featuredProjects.map((p, i) => (
      <div class="group reveal flex flex-col" style={`--delay: ${i * 0.1}s;`}>
        <div class="rounded-lg overflow-hidden relative aspect-[16/9] mb-6 shadow-md">
          <img
            src={p.image}
            alt={p.alt}
            loading="lazy"
            class="w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-105"
          />
          <div class="absolute inset-0 border rounded-lg pointer-events-none" style="border-color: var(--border);"></div>
        </div>
        <h3 class="text-2xl font-bold mb-3" style="font-family: var(--font-serif-heading); color: var(--text-primary); letter-spacing: -0.01em;">
          {p.title}
        </h3>
        <p class="text-sm md:text-base mb-6 flex-grow leading-relaxed" style="color: var(--text-secondary);">
          {p.description}
        </p>
        <div class="flex flex-wrap gap-2 mb-6">
          {p.tags.map((t) => <span class="tech-tag">{t}</span>)}
        </div>
        <div>
          <a href={p.github} target="_blank" rel="noopener noreferrer"
            class="inline-flex items-center gap-2 font-medium tracking-wide uppercase text-xs group/link"
            style="color: var(--text-primary); font-family: var(--font-mono);">
            <span class="border-b border-transparent group-hover/link:border-[var(--accent)] transition-colors duration-300">View on GitHub</span>
            <i class="fab fa-github transition-transform duration-300 group-hover/link:translate-x-1" style="color: var(--accent);"></i>
          </a>
        </div>
      </div>
    ))}
  </div>
</section>
