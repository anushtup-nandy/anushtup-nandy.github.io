---
import { featuredProjects } from '../data/projects';
---

<section id="featured-projects" class="plate">
  <div class="shell">
    <header class="sheet-head reveal">
      <p class="sheet-index">02 / Case study</p>
      <div>
        <h2 class="section-title">Featured <em>work</em></h2>
        <p class="sheet-lede">Two builds carried end to end — from first-principles modelling to instrumented hardware.</p>
      </div>
    </header>

    {featuredProjects.map((p, i) => (
      <article class:list={['case-study', 'reveal', i % 2 === 1 && 'flip']}>
        <div class="case-media">
          <div class="case-media-crop">
            <img src={p.image} alt={p.alt} loading="lazy" />
          </div>
          <figcaption class="case-caption">
            <span>Fig. {String(i + 1).padStart(2, '0')} — {p.title}</span>
            <span>{String(i + 1).padStart(2, '0')} / {String(featuredProjects.length).padStart(2, '0')}</span>
          </figcaption>
        </div>

        <div>
          <p class="case-index">{String(i + 1).padStart(2, '0')}</p>
          <h3 class="case-title">{p.title}</h3>
          <p class="case-desc">{p.description}</p>
          <div class="case-specs">
            {p.tags.map((t) => <span class="tech-tag">{t}</span>)}
          </div>
          <a href={p.github} target="_blank" rel="noopener noreferrer" class="link-quiet">
            View on GitHub <span aria-hidden="true">&#8599;</span>
          </a>
        </div>
      </article>
    ))}
  </div>
</section>
