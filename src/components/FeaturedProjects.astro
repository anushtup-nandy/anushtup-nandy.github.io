---
import { featuredProjects } from '../data/projects';
---

<section id="featured-projects" class="py-24">
  <h2 class="section-title mb-4 reveal">Featured Projects.</h2>
  <div>
    {featuredProjects.map((p, i) => (
      <article class="case-study reveal grid md:grid-cols-12 gap-8 md:gap-12 items-center">
        <div class:list={['case-media tick-frame md:col-span-7', i % 2 === 1 && 'md:order-2']}>
          <div class="case-media-crop">
            <img src={p.image} alt={p.alt} loading="lazy" class="w-full h-full object-cover" />
          </div>
        </div>
        <div class="md:col-span-5">
          <p class="case-index">{String(i + 1).padStart(2, '0')} /</p>
          <h3 class="case-title">{p.title}</h3>
          <p class="case-desc">{p.description}</p>
          <p class="case-specs">{p.tags.join(' · ')}</p>
          <a
            href={p.github}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 font-medium tracking-wide uppercase text-xs group/link"
            style="color: var(--text-primary); font-family: var(--font-mono);"
          >
            <span class="border-b border-transparent group-hover/link:border-[var(--accent)] transition-colors duration-300">View on GitHub</span>
            <i class="fab fa-github transition-transform duration-300 group-hover/link:translate-x-1" style="color: var(--accent);"></i>
          </a>
        </div>
      </article>
    ))}
  </div>
</section>
