---
import { site } from '../data/site';
const year = 2026;

const links = [
  { href: `mailto:${site.email}`, label: 'Email', external: false },
  { href: site.socials.linkedin, label: 'LinkedIn', external: true },
  { href: site.socials.github, label: 'GitHub', external: true },
  { href: '/rss.xml', label: 'RSS', external: false },
];
---

<footer>
  <div class="shell">
    <div class="footer-bar">
      <p class="metadata">© {year} {site.name} · {site.location}</p>
      <div class="footer-links">
        {links.map((l) => (
          <a href={l.href} {...(l.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}>
            {l.label}
          </a>
        ))}
      </div>
    </div>
  </div>
</footer>
