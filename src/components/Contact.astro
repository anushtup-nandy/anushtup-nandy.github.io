---
import { site } from '../data/site';

const channels = [
  { key: 'LinkedIn', value: 'in/anushtup-nandy', href: site.socials.linkedin, external: true },
  { key: 'GitHub', value: 'anushtup-nandy', href: site.socials.github, external: true },
  { key: 'Resume', value: 'Curriculum vitae (PDF)', href: '/pdfs/AnushtupNandyCV.pdf', external: true },
];
---

<section id="contact" class="plate">
  <div class="shell">
    <header class="sheet-head reveal">
      <p class="sheet-index">06 / Contact</p>
      <div>
        <h2 class="section-title">Get in <em>touch</em></h2>
        <p class="sheet-lede">
          I'm always open to discussing new projects, research, or potential collaborations. Feel free to reach out.
        </p>
      </div>
    </header>

    <a href={`mailto:${site.email}`} class="contact-mail reveal">{site.email}</a>

    <div class="channels reveal" style="--delay: 0.08s;">
      {channels.map((c) => (
        <a
          href={c.href}
          class="channel"
          {...(c.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
        >
          <span class="channel-key">{c.key}</span>
          <span class="channel-val">{c.value}</span>
          <span class="channel-go" aria-hidden="true">&#8599;</span>
        </a>
      ))}
    </div>
  </div>
</section>
