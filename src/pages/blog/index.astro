---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { formatDate, readingTime } from '../../utils';
import { site } from '../../data/site';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const categories = ['All', ...new Set(posts.map((p) => p.data.category))];
---

<BaseLayout
  title={`Writing — ${site.name}`}
  description="Notes on control, motion planning, sim-to-real, paper deep-dives, and hardware build logs."
>
  <section class="plate" style="padding-top: 11rem;">
    <div class="shell">
      <header class="sheet-head">
        <p class="sheet-index">00 / Field notes</p>
        <div>
          <h1 class="section-title">Writing</h1>
          <p class="sheet-lede">Derivations, sim-to-real notes, paper deep-dives, and build logs.</p>
        </div>
      </header>

      {posts.length === 0 ? (
        <div class="coming-soon">
          <span class="coming-soon-tag">Status: drafting</span>
          <div>
            <h2>Nothing published yet</h2>
            <p>Derivations, sim-to-real notes, and build logs are on the way. The RSS feed is live if you want them as they land.</p>
            <p class="mt-5"><a href="/rss.xml" class="link-quiet">Subscribe via RSS <span aria-hidden="true">&#8599;</span></a></p>
          </div>
        </div>
      ) : (
        <>
          <div class="category-filter mb-10">
            <span class="filter-indicator" aria-hidden="true"></span>
            {categories.map((c, i) => (
              <button class:list={['filter-btn', i === 0 && 'active']} data-category={c}>{c}</button>
            ))}
          </div>

          <div style="border-top: 1px solid var(--border);">
            {posts.map((post, i) => (
              <a href={`/blog/${post.id}/`} class="blog-card" data-category={post.data.category}>
                <span class="blog-n">{String(i + 1).padStart(2, '0')}</span>
                <div>
                  <h3>{post.data.title}</h3>
                  <p>{post.data.description}</p>
                </div>
                <div class="metadata" style="padding-top: 0.4rem;">
                  {post.data.category} · {formatDate(post.data.pubDate)} · {readingTime(post.body)} min
                </div>
              </a>
            ))}
          </div>
        </>
      )}
    </div>
  </section>

  <script>
    const buttons = [...document.querySelectorAll<HTMLButtonElement>('.filter-btn')];
    const cards = [...document.querySelectorAll<HTMLElement>('.blog-card')];
    const thumb = document.querySelector<HTMLElement>('.filter-indicator');

    const moveThumb = (btn: HTMLElement) => {
      if (!thumb) return;
      thumb.style.width = `${btn.offsetWidth}px`;
      thumb.style.height = `${btn.offsetHeight}px`;
      thumb.style.setProperty('--fx', `${btn.offsetLeft}px`);
      thumb.style.setProperty('--fy', `${btn.offsetTop}px`);
    };

    for (const button of buttons) {
      button.addEventListener('click', () => {
        const cat = button.dataset.category || 'All';
        for (const b of buttons) b.classList.toggle('active', b === button);
        moveThumb(button);
        for (const card of cards) {
          card.style.display = cat === 'All' || card.dataset.category === cat ? '' : 'none';
        }
      });
    }

    requestAnimationFrame(() => {
      const b = buttons.find((x) => x.classList.contains('active'));
      if (b) moveThumb(b);
      requestAnimationFrame(() => thumb?.classList.add('ready'));
    });
  </script>
</BaseLayout>
