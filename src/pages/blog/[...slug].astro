---
import { getCollection, render } from 'astro:content';
import BlogPost from '../../layouts/BlogPost.astro';

export async function getStaticPaths() {
  const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
    (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
  );

  return posts.map((post, i) => ({
    params: { slug: post.id },
    props: {
      post,
      // Newest-first ordering: "prev" = newer, "next" = older.
      prev: i > 0 ? { id: posts[i - 1].id, title: posts[i - 1].data.title } : undefined,
      next: i < posts.length - 1 ? { id: posts[i + 1].id, title: posts[i + 1].data.title } : undefined,
    },
  }));
}

const { post, prev, next } = Astro.props;
const { Content } = await render(post);
---

<BlogPost post={post} body={post.body} prev={prev} next={next}>
  <Content />
</BlogPost>
